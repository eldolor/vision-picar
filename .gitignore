__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.DS_Store

# Claude Code: session-local state stays out (settings.local.json and the
# like); the project's skills and shared settings are project content.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/

# Never commit secrets
.env
*.pem
recordings/
# ...but not the recordings domain's specs (docs/README.md)
!docs/recordings/
!docs/engineering/recordings/

# Lambda packaging output (service/lambda/build.sh)
.build/

# Detector weights, downloaded on first use by brain/perceive.py
# (requirements-perception.txt). ~18MB, and reproducible from the model
# name -- there is no reason for it to be in the repo.
yolo*.pt
# CLIP / YOLO-World checkpoints, downloaded on first use by the perception
# extras. ViT-B-32.pt alone is 338MB -- over GitHub's 100MB file limit,
# which is how this was noticed. All of them are reproducible from the
# model name, so none belongs in the repo.
weights/
*.pt
# YOLOE's text encoder, downloaded to the CWD on first use -- 572MB and
# 242MB of TorchScript, which the *.pt rules above do not match. Named
# rather than a blanket *.ts, which would be a surprising rule in a repo
# that may one day hold TypeScript.
mobileclip*.ts

# tools/hailo build products -- ~1.4GB of ONNX and ~1.8GB of calibration
# arrays, all reproducible from the corpus by two commands. The compile
# REPORT is the artifact worth keeping, and it goes in the plan document.
build/

# coverage.py databases -- artifacts of a local run, not source
.coverage
