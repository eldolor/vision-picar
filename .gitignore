# Lambda packaging output (service/lambda/build.sh)
.build/

# Detector weights, downloaded on first use by brain/perceive.py
# (requirements-perception.txt). ~18MB, and reproducible from the model
# name -- there is no reason for it to be in the repo.
yolo*.pt
# CLIP / YOLO-World checkpoints, downloaded on first use by the perception
# extras. ViT-B-32.pt alone is 338MB -- over GitHub's 100MB file limit,
# which is how this was noticed. All of them are reproducible from the
# model name, so none belongs in the repo.
weights/
*.pt

# tools/hailo build products -- ~1.4GB of ONNX and ~1.8GB of calibration
# arrays, all reproducible from the corpus by two commands. The compile
# REPORT is the artifact worth keeping, and it goes in the plan document.
build/
