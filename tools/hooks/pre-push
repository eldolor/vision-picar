#!/bin/sh
# The merge gate (docs/guides/PARALLEL-SESSIONS.md, rule 6). A push to `dev`
# runs `tools/plan_section.py gate`: a docs-only push runs the spec lint;
# anything else runs the FAST tier (no real-browser or live-stack tests)
# unless `plan_section.py ready` already recorded a pass for that commit.
# The full suite is not run on push (user, 2026-10-09) -- `ready --full`.
# Installed for every worktree by `git config core.hooksPath tools/hooks`.
# Override (the user's call, never a session's): PICAR_SKIP_GATE=1 git push ...
root="$(git rev-parse --show-toplevel)"
py="$(dirname "$(git rev-parse --git-common-dir)")/.venv/bin/python"
[ -x "$py" ] || py=python3
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/dev" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "${PICAR_SKIP_GATE:-}" = "1" ]; then
    echo "pre-push: merge gate SKIPPED for $local_sha (PICAR_SKIP_GATE=1)" >&2
    continue
  fi
  base="$remote_sha"
  [ "$base" = "$zero" ] && base="$(git merge-base origin/dev "$local_sha" 2>/dev/null)"
  "$py" "$root/tools/plan_section.py" gate "$base" "$local_sha" </dev/null || exit 1
done
exit 0
