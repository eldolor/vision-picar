#!/bin/sh
# Warn -- never block -- when a staged file lies inside a plan step another
# live Claude Code session has claimed (docs/guides/PARALLEL-SESSIONS.md,
# rule 8). Catches edits made through Bash, which the edit hook cannot see.
# Installed by `git config core.hooksPath tools/hooks` (or this checkout's
# absolute tools/hooks): it runs the plan_claims.py of the worktree committing,
# and does nothing in a worktree whose branch predates it.
root="$(git rev-parse --show-toplevel)"
[ -f "$root/tools/plan_claims.py" ] && python3 "$root/tools/plan_claims.py" hook-commit </dev/null
exit 0
